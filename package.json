{
  "name": "react-es-devtool",
  "version": "0.1.1",
  "description": "TanStack Devtools plugin that records EventSource and fetch SSE streams",
  "keywords": [
    "devtools",
    "eventsource",
    "react",
    "server-sent-events",
    "sse",
    "tanstack"
  ],
  "homepage": "https://github.com/timothyman1/react-es-devtool#readme",
  "bugs": "https://github.com/timothyman1/react-es-devtool/issues",
  "license": "MIT",
  "author": "a.sedov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timothyman1/react-es-devtool.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/event-source.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.lib.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "prepublishOnly": "pnpm build",
    "format": "oxfmt"
  },
  "dependencies": {
    "@tanstack/devtools-event-client": "^0.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "packageManager": "pnpm@12.4.1"
}
